# Copy this file to .env and fill in real values for your project.
# .env is gitignored — never commit it, never paste its contents into chat.

# IMPORTANT: testing skills read this file via the shell (`source .env`),
# not a dedicated parser — so every value below MUST be single-quoted.
# An unquoted value containing a space is silently truncated, and an
# unquoted value containing `$`, backticks, `;`, or `&` is executed as a
# shell command instead of treated as a literal password/URL. Always
# quote, even for values that look safe today.

# The site's base URL.
BASE_URL='https://staging.example.com'

# Primary test user credentials.
TEST_USER_EMAIL='qa@example.com'
TEST_USER_PASSWORD=''

# If your site has more than one relevant test role, add more pairs
# following this same pattern (single-quoted), e.g.:
# TEST_ADMIN_EMAIL='admin@example.com'
# TEST_ADMIN_PASSWORD=''

# Optional: an API key or token the site under test requires (a header
# the app needs, a feature-flag token to enable functionality under
# test). Leave commented out if not applicable to this project.
# API_KEY=''

# ============================================================================
# CLICKUP INTEGRATION (Required for /report-bugs-to-clickup)
# ============================================================================

# ClickUp Personal Access Token
# Generate at: https://app.clickup.com/settings → API → Generate Token
# Format: begins with 'pk_'
CLICKUP_API_KEY=''

# ClickUp Bugs List ID (where bug tickets will be created)
# Find in URL when viewing your Bugs list: /l/[LIST_ID]/
# Use only the numeric ID, e.g.: 123456789012
CLICKUP_BUGS_LIST_ID=''

# ClickUp Sprint List ID (where tickets will be associated for sprint tracking)
# Find in URL when viewing your active Sprint list: /l/[LIST_ID]/
# Use only the numeric ID, e.g.: 123456789014
CLICKUP_SPRINT_LIST_ID=''
